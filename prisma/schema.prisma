// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emoji       String
  typicalItems String
  frequency   String
  group       String   @default("Other")
  sortOrder   Int      @default(0)
  suppliers   SupplierCategory[]
  inquiries   Inquiry[]

  @@index([sortOrder])
}

model Supplier {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  city        String
  address     String?
  phone       String?
  whatsapp    String?
  telegram    String?
  email       String?
  website     String?
  verified    Boolean  @default(false)
  sponsored   Boolean  @default(false)
  createdAt   DateTime @default(now())
  categories  SupplierCategory[]
  products    SupplierProduct[]

  @@index([city])
}

// A supplier's own product list, shown only on that supplier's page — not a
// cross-supplier catalog or comparison. Products aren't matched against each
// other (a "cucumber" from one supplier isn't assumed equivalent to another
// supplier's "cucumber") since quality/origin/grade make that misleading.
model SupplierProduct {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  unit       String?
  price      Float?
  currency   String   @default("USD")
  notes      String?
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, name])
}

// A buyer's request, emailed out to every supplier in a category that has an
// email on file. Covers both the simple category-page widget (just an email)
// and a future fuller RFQ form (adds item/quantity/notes) — same backend.
model Inquiry {
  id           String    @id @default(cuid())
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  buyerEmail   String
  buyerName    String?
  business     String?
  item         String?
  quantity     String?
  notes        String?
  suppliersSent Int      @default(0)
  createdAt    DateTime  @default(now())

  @@index([categoryId])
  @@index([buyerEmail, categoryId])
}

// A raw self-submission from the public form (supplier.restaurant-cambodia.com),
// pending manual review — never becomes a live Supplier automatically. Category
// names, product rows, and brands are stored as-submitted (JSON/arrays) since
// this is unvalidated input; mapping to real Category slugs and creating the
// actual Supplier/SupplierProduct rows happens by hand via the sync endpoints
// once reviewed, same as sheet-driven submissions.
model SupplierSubmission {
  id              String   @id @default(cuid())
  name            String
  description     String?
  city            String?
  address         String?
  phone           String?
  whatsapp        String?
  telegram        String?
  email           String?
  website         String?
  facebook        String?
  supplierType    String?
  areasServed     String[]
  nationwide      Boolean  @default(false)
  delivery        Boolean  @default(false)
  pickup          Boolean  @default(false)
  categories      String[]
  otherCategory   String?
  products        Json?
  brands          String[]
  // Private verification contact — never published, used only so we can
  // reach the actual submitter (per Franck's Telegram-based verify process).
  contactTelegram String?
  consent         Boolean  @default(false)
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@index([status])
}

model SupplierCategory {
  supplierId String
  categoryId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([supplierId, categoryId])
  @@index([categoryId])
}
