// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emoji       String
  typicalItems String
  frequency   String
  group       String   @default("Other")
  sortOrder   Int      @default(0)
  suppliers   SupplierCategory[]
  inquiries   Inquiry[]

  @@index([sortOrder])
}

model Supplier {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  city        String
  address     String?
  phone       String?
  whatsapp    String?
  telegram    String?
  email       String?
  website     String?
  verified    Boolean  @default(false)
  sponsored   Boolean  @default(false)
  createdAt   DateTime @default(now())
  categories  SupplierCategory[]
  products    SupplierProduct[]

  @@index([city])
}

// A supplier's own product list, shown only on that supplier's page — not a
// cross-supplier catalog or comparison. Products aren't matched against each
// other (a "cucumber" from one supplier isn't assumed equivalent to another
// supplier's "cucumber") since quality/origin/grade make that misleading.
model SupplierProduct {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  unit       String?
  price      Float?
  currency   String   @default("USD")
  notes      String?
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, name])
}

// A buyer's request, emailed out to every supplier in a category that has an
// email on file. Covers both the simple category-page widget (just an email)
// and a future fuller RFQ form (adds item/quantity/notes) — same backend.
model Inquiry {
  id           String    @id @default(cuid())
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  buyerEmail   String
  buyerName    String?
  business     String?
  item         String?
  quantity     String?
  notes        String?
  suppliersSent Int      @default(0)
  createdAt    DateTime  @default(now())

  @@index([categoryId])
  @@index([buyerEmail, categoryId])
}

model SupplierCategory {
  supplierId String
  categoryId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([supplierId, categoryId])
  @@index([categoryId])
}
